# 決策引擎:TYPESAFE_API_KEY 有設就用 jev,否則 ANTHROPIC_API_KEY 有設就用 Claude,
# 都沒設就用規則引擎(畫面照常運作)。要強制指定就設 SHOP_DECISION_ENGINE=jev|claude|rules
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# 可選(jev)
TYPESAFE_DEFAULT_MODEL=jev-latest
SHOP_JEV_TIMEOUT_MS=8000
# 可選
SHOP_CLAUDE_MODEL=claude-opus-5
SHOP_CLAUDE_EFFORT=low
MARKET_TICK_MS=2500
PORT=8787
